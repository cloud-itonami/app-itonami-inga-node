(ns inga-node.node-test
  "One witness, alone, restarted.

  `devnet` was supposed to prove this and cannot: its restart leg runs only
  after its kill leg, and the kill leg fails on a defect in `inga` that has
  nothing to do with restarting. So the single property a process has to have
  to replace a Durable Object — **it comes back** — has never actually been
  checked. This namespace checks it, with no peers and no sockets to anyone,
  because none of that is needed to answer the question.

  A lone witness never commits anything (quorum of one witness is still a
  quorum it cannot reach with n=4 configured), and that is fine: what has to
  survive here is the replica's own state and the submitted work, which is
  exactly what `inga.replica/snapshot` carries and what a cold start would
  silently discard."
  (:require [kotoba.test :refer [deftest is testing async]]
            [kotoba.lang.text :as str]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]
            [inga-node.identity :as ident]
            [inga-node.store :as store]
            [inga-node.node :as node]
            [inga-node.seams :as seams]
            [inga.replica :as r]
            [inga.net.ws :as nws]
            ["node:crypto" :as crypto]))

(defn- tmp [] (fs/mkdtempSync (path/join (os/tmpdir) "inga-node-node-")))

;; Derived from the pid so two runs on one machine cannot collide, which is
;; how the devnet harness spent two diagnoses talking to its own leftovers.
(def ^:private base-port (+ 21000 (mod (.-pid js/process) 3000)))
(defn- port [n] (+ base-port n))

(defn- boot
  "A lone witness on `d`. `:witnesses` is four so the quorum is unreachable —
  this is about persistence, not agreement."
  [d p]
  (node/start! {:witness "w1" :witnesses ["w1" "w2" "w3" "w4"]
                :peers {} :pubkeys {}
                :seed-hex (ident/ensure-seed! d)
                :chain-id "inga-node-test" :port p
                :tick-ms 100000   ; long enough that no tick fires mid-test
                :data-dir d}))

(defn- GET [p path]
  (-> (js/fetch (str "http://127.0.0.1:" p path)) (.then #(.json %))))

(defn- POST [p path body]
  (-> (js/fetch (str "http://127.0.0.1:" p path)
                #js {:method "POST" :headers #js {"content-type" "application/json"}
                     :body (js/JSON.stringify (clj->js body))})
      (.then (fn [r] (-> (.json r) (.then (fn [j] [(.-status r) j])))))))

(defn- rec [ref seq' cid]
  {"v" "inga.head/v1" "ref" ref "seq" seq' "cid" cid "prev" nil "height" nil})

(defn- once [done] (let [f (atom false)] (fn [] (when-not @f (reset! f true) (done)))))

(deftest enabling-a-complete-archive-after-a-bounded-snapshot-refuses
  (let [d (tmp)
        seed (ident/ensure-seed! d)
        opts {:witness "w1" :witnesses ["w1" "w2" "w3" "w4"]
              :quorum 3 :chain-id "inga-node-test" :hash-fn seams/hash-fn
              :sign-fn (seams/sign-fn seed) :verify-fn (seams/verify-fn {})}
        snap (assoc (r/snapshot (r/replica opts))
                    :committed [{:inga.block/height 7 :inga.block/proposals []}])]
    (store/write-snapshot! d snap)
    (is (thrown? js/Error
          (node/start! {:witness "w1" :witnesses ["w1" "w2" "w3" "w4"]
                        :peers {} :pubkeys {} :seed-hex seed
                        :chain-id "inga-node-test" :port 0 :tick-ms 100000
                        :data-dir d :archive-finalized? true}))
        "turning on the archive after history was pruned cannot fabricate genesis")))

(deftest a-restart-keeps-the-submitted-work
  (testing "the property that replaces the Durable Object: it comes back"
    (async raw-done
      (let [done (once raw-done)
            d (tmp) p (port 1)
            n1 (boot d p)]
        (-> (POST p "/submit" {"record" (rec "g" 0 "cid-a")})
            (.then (fn [[status _]]
                     (is (= 200 status))
                     (GET p "/health")))
            (.then (fn [h]
                     (is (= 1 (aget h "pending")) "submitted work is queued")
                     ((:stop! n1))
                     ;; a NEW process would read the same directory; a new
                     ;; `start!` on the same data-dir is that, minus the fork
                     (let [n2 (boot d (port 2))]
                       (-> (GET (port 2) "/health")
                           (.then (fn [h2]
                                    (is (= 1 (aget h2 "pending"))
                                        "a cold start would report 0 here and look fine")
                                    (is (= "w1" (aget h2 "witness")))
                                    ((:stop! n2))
                                    (done)))))))
            (.catch (fn [e] (is false (str "threw: " (or (.-message e) e))) (done))))))))

(deftest a-restart-with-no-snapshot-starts-clean
  (testing "a fresh data dir is not an error condition"
    (async raw-done
      (let [done (once raw-done)
            d (tmp) p (port 3)
            n (boot d p)]
        (-> (GET p "/health")
            (.then (fn [h]
                     (is (true? (aget h "ok")))
                     (is (= 0 (aget h "pending")))
                     (is (= "inga-node-test" (aget h "chain-id")))
                     ((:stop! n))
                     (done)))
            (.catch (fn [e] (is false (str "threw: " (or (.-message e) e))) (done))))))))

(deftest an-unusable-snapshot-refuses-to-boot
  (doseq [contents ["{:truncated" "{:inga.snapshot/version -1}" "nil" "false" "{}"]]
    (let [d (tmp)]
      (fs/writeFileSync (store/snapshot-path d) contents "utf8")
      (is (thrown? js/Error (boot d (port 4))))
      (is (= contents (fs/readFileSync (store/snapshot-path d) "utf8"))))))

(deftest submit-refuses-a-record-that-is-not-one
  (async raw-done
    (let [done (once raw-done)
          d (tmp) p (port 5)
          n (boot d p)]
      (-> (POST p "/submit" {"record" {"ref" "g"}})
          (.then (fn [[status j]]
                   (is (= 400 status))
                   (is (false? (aget j "ok")))
                   (GET p "/health")))
          (.then (fn [h]
                   (is (= 0 (aget h "pending"))
                       "a refused record must not reach the replica's queue")
                   ((:stop! n))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (or (.-message e) e))) (done)))))))

(deftest health-names-the-fault-model
  (testing "what the fault model IS depends on where the keys live, so it is asserted"
    (async raw-done
      (let [done (once raw-done)
            d (tmp) p (port 6)
            n (boot d p)]
        (-> (GET p "/health")
            (.then (fn [h]
                     ;; If someone ever moves seed generation out of the node,
                     ;; this string stops being true and this test is where
                     ;; that gets noticed.
                     (is (str/includes? (aget h "fault-model") "one key per host"))
                     (is (fs/existsSync (path/join d "seed"))
                         "and the key it is claiming about is on this host's disk")
                     ((:stop! n))
                     (done)))
            (.catch (fn [e] (is false (str "threw: " (or (.-message e) e))) (done))))))))

(deftest committed-reports-the-durable-log-not-memory
  (async raw-done
    (let [done (once raw-done)
          d (tmp) p (port 7)
          n (boot d p)]
      ;; written behind the node's back, exactly as a commit would
      (store/sink-blocks! d [{:inga.block/proposals
                              [(js/JSON.stringify (clj->js (rec "g" 0 "cid-a")))]}])
      (-> (GET p "/committed?ref=g")
          (.then (fn [j]
                   (is (= 1 (aget j "records")))
                   (is (= "filesystem" (aget j "source")) "and says where the answer came from")
                   (is (= "cid-a" (aget (aget j "head") "cid")))
                   ((:stop! n))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (or (.-message e) e))) (done)))))))

;; Tests call the actual advance! closure returned by start!, using the real
;; signed replica transition. Only transport delivery and failure injection
;; are replaced. No network peer, credential store, or funds are involved.
(defn- boot-captured
  ([d sent] (boot-captured d sent (.toString (crypto/randomBytes 32) "hex")))
  ([d sent seed]
    (with-redefs [nws/make-node
                  (fn [_] {:tick! (fn []) :close-all! (fn [])
                           :broadcast! (fn [msg]
                                         (when (= :vote (:type msg))
                                           (is (>= (:voted-view (store/read-snapshot d)) 0)
                                               "durable vote watermark precedes real ship!"))
                                         (swap! sent conj msg))})]
      (assoc (node/start! {:witness "w2" :witnesses ["w1" "w2" "w3" "w4"]
                    :peers {} :pubkeys {"w2" (seams/public-hex seed)}
                    :seed-hex seed :chain-id "durability-test" :port 0
                    :tick-ms 100000 :data-dir d}) :test-seed seed))))

(deftest persist-failure-emits-zero-votes-and-poisons-instance
  (let [d (tmp) sent (atom []) n (boot-captured d sent)]
    (try
      (with-redefs [store/write-snapshot! (fn [& _] (throw (js/Error. "disk failure")))]
        (is (thrown? js/Error ((:advance! n) #(r/start % 0)))))
      (is (empty? @sent))
      (is (= -1 (r/voted-view @(:state n))))
      (is (thrown? js/Error ((:advance! n) #(r/start % 0))))
      (is (empty? @sent))
      (finally ((:stop! n))))))

(deftest unchanged-working-state-skips-fsync-but-vote-watermark-survives-restart
  (let [d (tmp) sent (atom []) n (boot-captured d sent)
        write! store/write-snapshot! writes (atom 0)]
    (try
      ((:advance! n) #(r/start % 0))
      (with-redefs [store/write-snapshot! (fn [dir snapshot]
                                           (swap! writes inc)
                                           (write! dir snapshot))]
        (dotimes [_ 200]
          ((:advance! n) (fn [s] [s []])))
        (is (= 0 @writes) "unchanged network work must not fsync a duplicate snapshot")
        ((:advance! n) (fn [s] [(r/with-voted-view s 9) []]))
        (is (= 1 @writes) "a signing watermark must still be durable")
        ((:advance! n) (fn [s] [(r/with-voted-view s 9) []]))
        (is (= 1 @writes) "repeating the same watermark is not another write"))
      (is (= 9 (:voted-view (store/read-snapshot d))))
      (finally ((:stop! n))))
    (let [resumed (boot-captured d (atom []) (:test-seed n))]
      (try
        (is (= 9 (r/voted-view @(:state resumed))))
        (finally ((:stop! resumed)))))))

(deftest persisted-vote-survives-stop-before-and-after-shipping
  (doseq [crash-before-ship? [true false]]
    (let [d (tmp) sent (atom []) n (boot-captured d sent)
          write! store/write-snapshot! saved (atom nil)]
      (try
        (if crash-before-ship?
          (with-redefs [store/write-snapshot!
                        (fn [dir snap]
                          (write! dir snap)
                          (reset! saved snap)
                          (throw (js/Error. "stop after durable write before ship")))]
            (is (thrown? js/Error ((:advance! n) #(r/start % 0)))))
          (do ((:advance! n) #(r/start % 0))
              (reset! saved (store/read-snapshot d))))
        (is (>= (:voted-view @saved) 0))
        (is (= crash-before-ship? (empty? @sent)))
        (when-not crash-before-ship?
          (is (some #(= :vote (:type %)) @sent)))
        (finally ((:stop! n))))
      ;; A second real start! restores the durable snapshot with the SAME key.
      (let [resent (atom []) n2 (boot-captured d resent (:test-seed n))]
        (try
          (let [resumed @(:state n2)
                tip (r/tip resumed)
                conflicting (assoc tip :inga.block/proposals ["different-intent"])]
            (is (= (:voted-view @saved) (r/voted-view resumed)))
            ((:advance! n2) #(r/on-message % {:type :proposal :block conflicting} 1))
            (is (not-any? #(= :vote (:type %)) @resent))
            (is (= (seams/hash-fn tip) (seams/hash-fn (r/tip @(:state n2))))))
          (finally ((:stop! n2))))))))

(deftest failed-instance-cannot-overwrite-durable-state-through-submit
  (async done
    (let [d (tmp) p (port 8) n (boot d p)
          write! store/write-snapshot!]
      (with-redefs [store/write-snapshot! (fn [dir snap]
                                          (write! dir snap)
                                          (throw (js/Error. "uncertain directory flush")))]
        (is (thrown? js/Error ((:advance! n) #(vector (r/with-voted-view % 9) [])))))
      (let [before (fs/readFileSync (store/snapshot-path d) "utf8")]
        (-> (POST p "/submit" {"record" (rec "g" 0 "other")})
            (.then (fn [[status _]]
                     (is (= 503 status))
                     (is (= before (fs/readFileSync (store/snapshot-path d) "utf8")))))
            (.catch (fn [e] (is false (str e))))
            (.finally (fn [] ((:stop! n)) (done))))))))

(deftest a-lock-conflicting-with-a-committed-block-fails-closed
  (let [d (tmp) sent (atom []) n (boot-captured d sent)
        original @(:state n)
        committed (r/tip original)
        bad (-> original
                (assoc :committed [committed])
                (assoc-in [:pm :locked-qc]
                          {:inga.qc/height (:inga.block/height committed)
                           :inga.qc/block-hash "conflicting-certified-fork"}))]
    (try
      (store/write-snapshot! d (r/snapshot original))
      (let [before (fs/readFileSync (store/snapshot-path d) "utf8")]
      (is (= (:inga.block/height committed)
             (:height (node/committed-lock-conflict bad))))
      (is (= (seams/hash-fn committed)
             (:committed-hash (node/committed-lock-conflict bad))))
      (is (nil? (node/committed-lock-conflict original)))
      (let [error (try ((:advance! n) (fn [_] [bad [{:to :all :msg {:type :vote}}]]))
                       nil
                       (catch :default e e))]
        (is (some? error))
        (is (str/includes? (.-message error) "lock conflicts with committed block")))
      (is (= before (fs/readFileSync (store/snapshot-path d) "utf8"))
          "the conflicting state was not made durable")
      (is (empty? @sent) "no vote escaped the safety refusal")
      (is (thrown? js/Error ((:advance! n) (fn [s] [s []])))
          "a poisoned process cannot resume signing"))
      (finally ((:stop! n))))
    (store/write-snapshot! d (r/snapshot bad))
    (let [error (try (boot-captured d (atom []) (:test-seed n))
                     nil
                     (catch :default e e))]
      (is (some? error) "a restart must refuse the same conflicting durable state")
      (is (str/includes? (.-message error) "lock conflicts with committed block")))))
