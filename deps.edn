{:paths ["src"]
 :version "0.1.0"
 ;; inga — the decisions this layer executes. Nothing else: a mechanism layer
 ;; that grows a second dependency is usually growing a second opinion.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/inga
        {:git/url "https://github.com/kotoba-lang/inga.git"
         ;; Advanced for `inga.commitment`: `inga_node.ref` composes it, and a
         ;; pin behind the namespace it requires is a dependency that resolves
         ;; on one machine and not the next.
         :git/sha "ba437b4efd8d43ed00bf75a6cb48671bcec8f6e7"}}
 :aliases
 {:lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "script"
                     "--fail-level" "error"]}}}
