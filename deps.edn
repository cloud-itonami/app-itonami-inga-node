{:paths ["src"]
 :version "0.1.0"
 ;; inga — the decisions this layer executes. Nothing else: a mechanism layer
 ;; that grows a second dependency is usually growing a second opinion.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "41718d36ba2f1d86e6c5a11524ee9f904cbaf9a3"}
       io.github.kotoba-lang/inga
        {:git/url "https://github.com/kotoba-lang/inga.git"
         ;; Advanced for `inga.commitment`: `inga_node.ref` composes it, and a
         ;; pin behind the namespace it requires is a dependency that resolves
         ;; on one machine and not the next.
         :git/sha "817bb2b5b9f3e3be282abbfb7f01deb491c36c24"}
       io.github.kotoba-lang/kotobase-client
        {:git/url "https://github.com/kotoba-lang/kotobase-client.git"
         :git/sha "c7882c58efe2fe558fc2b512678c2ab56088fcc0"}
       io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
         :git/sha "45c9f58d7f800399c7288582a149b7395543b72d"}}
 :aliases
 {:lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "script"
                     "--fail-level" "error"]}}}
