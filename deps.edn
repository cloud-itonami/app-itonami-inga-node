{:paths ["src"]
 :version "0.1.0"
 ;; inga — the decisions this layer executes. Nothing else: a mechanism layer
 ;; that grows a second dependency is usually growing a second opinion.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "41718d36ba2f1d86e6c5a11524ee9f904cbaf9a3"}
       io.github.kotoba-lang/inga
        {:git/url "https://github.com/kotoba-lang/inga.git"
         ;; Archive-backed sync requires certified ahead-branch requests from
         ;; this floor. A node deployed with an older inga cannot recover a
         ;; divergent uncommitted suffix after restart.
         ;; inga.writer (writer policy). Points at kotoba-lang/inga#22 until it
         ;; merges; move to the merge commit before this PR merges.
         :git/sha "ed17b547efe318da616358b6a0a09f888b36f25a"}
       io.github.kotoba-lang/kotobase-client
        {:git/url "https://github.com/kotoba-lang/kotobase-client.git"
         :git/sha "c7882c58efe2fe558fc2b512678c2ab56088fcc0"}
       io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
         :git/sha "45c9f58d7f800399c7288582a149b7395543b72d"}}
 :aliases
 {:lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "script"
                     "--fail-level" "error"]}}}
